{
  "biome.configurationPath": "./frontend/biome.json",
  "biome.lsp.bin": {
    "linux-x64": "./frontend/node_modules/@biomejs/cli-linux-x64/biome",
    "darwin-arm64": "./frontend/node_modules/@biomejs/cli-darwin-arm64/biome",
    "win32-x64": "./frontend/node_modules/@biomejs/cli-win32-x64/biome.exe"
  },
  "prettier.enable": false,
  "eslint.enable": false,
  "[javascript][javascriptreact][typescript][typescriptreact][json][jsonc][css][markdown]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.biome": "explicit",
      "source.organizeImports.biome": "explicit"
    }
  }
}
